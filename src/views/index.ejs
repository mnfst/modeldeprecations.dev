<section class="pt-10">
  <h1 class="text-balance font-bold tracking-tight">Which AI models are being shut down?</h1>
  <p class="mt-4 max-w-3xl text-pretty text-base text-slate-700">
    One page per model, answering the same three questions: is it deprecated, when does it shut
    down, and what replaces it. Every date is cited to the provider's own documentation, with the
    day we last checked it. <%= rows.length %> models tracked, current as of <%= helpers.formatDate(today) %>.
  </p>
  <div class="mt-5 flex flex-wrap gap-3 text-sm">
    <a href="<%= calendarPath %>" class="inline-flex items-center gap-2 bg-slate-900 px-4 py-2 font-medium text-white hover:bg-slate-800">Shutdown calendar</a>
    <a href="/calendar.ics" rel="nofollow" class="inline-flex items-center gap-2 border border-slate-300 px-4 py-2 font-medium text-slate-700 hover:bg-warm-hover">Subscribe (.ics)</a>
    <a href="/api" class="inline-flex items-center gap-2 border border-slate-300 px-4 py-2 font-medium text-slate-700 hover:bg-warm-hover">JSON API</a>
  </div>
</section>

<% if (upcoming.length > 0) { %>
<section class="mt-12" aria-labelledby="next-shutdowns">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 id="next-shutdowns" class="text-slate-900">Next shutdowns</h2>
    <a href="<%= calendarPath %>" class="text-sm text-accent hover:text-accent-hover">Full calendar →</a>
  </div>
  <p class="mt-2 max-w-2xl text-sm text-slate-600">
    The models that stop answering soonest. <%= upcoming.length %> shutdowns are still ahead.
  </p>
  <ol class="mt-5 grid grid-cols-1 gap-px bg-slate-200 sm:grid-cols-2 lg:grid-cols-3">
    <% for (const row of upcoming.slice(0, 6)) { %>
    <li class="bg-white p-4">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <a href="<%= helpers.modelPagePath(row.model) %>" class="block truncate font-medium text-slate-900 hover:text-accent"><%= row.model.name %></a>
          <p class="mt-0.5 truncate font-mono text-xs text-slate-500"><%= row.model.model %></p>
        </div>
        <%- include("partials/status_pill", { life: row.life, helpers: helpers }) %>
      </div>
      <p class="mt-3 text-sm tabular-nums <%= (row.life.daysToShutdown ?? 999) < 60 ? 'text-rose-700' : 'text-slate-700' %>">
        <%= helpers.formatDate(row.life.shutdown) %> · <%= helpers.relativeDays(row.life.daysToShutdown) %>
      </p>
    </li>
    <% } %>
  </ol>
</section>
<% } %>

<section class="mt-12" aria-labelledby="providers">
  <h2 id="providers" class="text-slate-900">By provider</h2>
  <div class="mt-4 grid grid-cols-1 gap-px bg-slate-200 sm:grid-cols-2 lg:grid-cols-3">
    <% for (const facet of facets) { %>
    <% const logo = helpers.logoFor(facet.provider); %>
    <a href="<%= helpers.providerPagePath(facet.provider) %>" class="group bg-white p-4 hover:bg-warm-hover/40">
      <div class="flex items-center gap-2">
        <% if (logo) { %><span class="provider-logo inline-flex h-4 w-4 shrink-0 items-center justify-center" aria-hidden="true"><%- logo %></span><% } %>
        <span class="font-medium text-slate-900 group-hover:text-accent"><%= helpers.providerLabel(facet.provider) %></span>
      </div>
      <p class="mt-2 text-sm text-slate-600">
        <span class="tabular-nums font-medium text-amber-700"><%= facet.deprecated %></span> deprecated ·
        <span class="tabular-nums font-medium text-rose-700"><%= facet.retired %></span> retired ·
        <span class="tabular-nums font-medium text-emerald-700"><%= facet.active %></span> active
      </p>
    </a>
    <% } %>
  </div>
</section>

<section class="mt-12" aria-labelledby="by-lifecycle">
  <h2 id="by-lifecycle" class="text-slate-900">By lifecycle</h2>
  <p class="mt-2 max-w-2xl text-sm text-slate-600">
    The same catalog sliced by where a model is in its life, and by the year it stops answering.
  </p>
  <div class="mt-4 flex flex-wrap gap-2 text-sm">
    <a href="/deprecated" class="border border-slate-300 px-3 py-1.5 text-slate-600 hover:bg-warm-hover">Deprecated models</a>
    <a href="/retired" class="border border-slate-300 px-3 py-1.5 text-slate-600 hover:bg-warm-hover">Retired models</a>
    <% for (const year of years) { %>
    <a href="/shutdowns/<%= year %>" class="border border-slate-300 px-3 py-1.5 text-slate-600 hover:bg-warm-hover">Shutdowns in <%= year %></a>
    <% } %>
  </div>
</section>

<section class="mt-12" aria-labelledby="all-models">
  <h2 id="all-models" class="text-slate-900">Every model we track</h2>
  <div class="mt-4 flex flex-wrap items-center gap-2">
    <label for="model-search" class="sr-only">Filter models</label>
    <input id="model-search" type="search" data-search placeholder="Filter by model or provider…" class="w-full max-w-sm border border-slate-300 px-3 py-2 text-sm placeholder:text-slate-400 focus:border-accent focus:outline-none" />
    <div class="flex flex-wrap gap-1" role="group" aria-label="Filter by status">
      <% for (const status of ["all", "deprecated", "retired", "active"]) { %>
      <button type="button" data-status-filter="<%= status %>" data-active="<%= status === 'all' %>" class="border border-slate-300 px-3 py-2 text-sm capitalize text-slate-600 data-[active=true]:border-slate-900 data-[active=true]:bg-slate-900 data-[active=true]:text-white"><%= status %></button>
      <% } %>
    </div>
  </div>

  <div class="mt-4 overflow-x-auto border border-slate-200">
    <table class="w-full min-w-[46rem] text-left text-sm">
      <thead class="bg-warm-tag text-xs uppercase tracking-[0.06em] text-slate-500">
        <tr>
          <th scope="col" class="px-3 py-2 font-semibold">Model</th>
          <th scope="col" class="px-3 py-2 font-semibold">Provider</th>
          <th scope="col" class="px-3 py-2 font-semibold">Status</th>
          <th scope="col" class="px-3 py-2 font-semibold">Shutdown</th>
          <th scope="col" class="px-3 py-2 font-semibold">Replacement</th>
        </tr>
      </thead>
      <tbody data-model-table>
        <% for (const row of rows) { %>
        <%- include("partials/model_row", { row: row, helpers: helpers, showProvider: true }) %>
        <% } %>
      </tbody>
    </table>
  </div>
  <p data-empty-state hidden class="mt-4 text-sm text-slate-500">No model matches that filter.</p>
</section>

<% if (recent.length > 0) { %>
<section class="mt-12" aria-labelledby="recently-retired">
  <h2 id="recently-retired" class="text-slate-900">Recently retired</h2>
  <p class="mt-2 max-w-2xl text-sm text-slate-600">Models that have already stopped answering. Calls to these return an error.</p>
  <ul class="mt-4 divide-y divide-slate-100 border border-slate-200">
    <% for (const row of recent) { %>
    <li class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-3 text-sm">
      <a href="<%= helpers.modelPagePath(row.model) %>" class="font-medium text-slate-900 hover:text-accent"><%= row.model.name %></a>
      <span class="font-mono text-xs text-slate-500"><%= row.model.model %></span>
      <span class="ml-auto tabular-nums text-slate-500">shut down <%= helpers.formatDate(row.life.shutdown) %></span>
    </li>
    <% } %>
  </ul>
</section>
<% } %>
