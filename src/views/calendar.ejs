<%- include("partials/breadcrumbs", { items: [
  { name: "Home", href: "/" },
  { name: "Shutdown calendar" }
] }) %>

<section class="pt-6">
  <h1 class="text-balance font-bold tracking-tight">AI model shutdown calendar</h1>
  <p class="mt-4 max-w-3xl text-pretty text-base text-slate-700">
    Every announced shutdown date, in order. <%= upcomingCount %> are still ahead as of
    <%= helpers.formatDate(today) %>. Subscribe and they land in the same calendar as everything
    else you plan around — no one should learn a model was retired from a 404 in production.
  </p>
  <div class="mt-5 flex flex-wrap gap-3 text-sm">
    <a href="<%= icsPath %>" rel="nofollow" class="inline-flex items-center gap-2 bg-slate-900 px-4 py-2 font-medium text-white hover:bg-slate-800">
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 11h18"/></svg>
      Subscribe (.ics)
    </a>
    <button type="button" data-copy-text="<%= icsPath %>" class="inline-flex items-center gap-2 border border-slate-300 px-4 py-2 font-medium text-slate-700 hover:bg-warm-hover"><span data-copy-label>Copy feed URL</span></button>
  </div>
  <p class="mt-3 text-xs text-slate-500">
    Google Calendar: Other calendars → From URL. Apple Calendar: File → New Calendar Subscription.
  </p>
</section>

<% if (months.length === 0) { %>
<p class="mt-10 text-sm text-slate-500">No shutdowns are scheduled ahead of today.</p>
<% } %>

<% for (const month of months) { %>
<section class="mt-10" aria-labelledby="month-<%= month.month %>">
  <h2 id="month-<%= month.month %>" class="text-slate-900"><%= month.label %></h2>
  <ul class="mt-3 divide-y divide-slate-100 border border-slate-200">
    <% for (const row of month.entries) { %>
    <li class="flex flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3">
      <div class="w-14 shrink-0 text-center">
        <div class="text-lg font-semibold tabular-nums leading-none text-slate-900"><%= Number(row.life.shutdown.slice(8, 10)) %></div>
        <div class="mt-0.5 text-[10px] uppercase tracking-wide text-slate-400"><%= month.label.slice(0, 3) %></div>
      </div>
      <div class="min-w-0 flex-1">
        <a href="<%= helpers.modelPagePath(row.model) %>" class="font-medium text-slate-900 hover:text-accent"><%= helpers.modelFullLabel(row.model) %></a>
        <div class="mt-0.5 font-mono text-xs text-slate-500"><%= row.model.model %><% if (row.life.soft) { %> <span class="font-sans text-slate-400">· earliest</span><% } %></div>
      </div>
      <% const rep = (row.model.replacements || []).find((r) => r.recommended) || (row.model.replacements || [])[0]; %>
      <% if (rep) { %>
      <div class="text-sm">
        <span class="text-slate-400">→ </span>
        <a href="/<%= rep.provider %>/<%= rep.model %>" class="font-mono text-xs text-accent hover:text-accent-hover"><%= rep.model %></a>
      </div>
      <% } %>
      <div class="ml-auto text-sm tabular-nums <%= (row.life.daysToShutdown ?? 999) < 60 ? 'text-rose-700' : 'text-slate-500' %>">
        <%= helpers.relativeDays(row.life.daysToShutdown) %>
      </div>
    </li>
    <% } %>
  </ul>
</section>
<% } %>

<% if (past.length > 0) { %>
<section class="mt-12 border-t border-slate-200 pt-8" aria-labelledby="past">
  <h2 id="past" class="text-slate-900">Already shut down</h2>
  <p class="mt-2 max-w-2xl text-sm text-slate-600">
    The archive. Every one of these ids now returns an error.
  </p>
  <ul class="mt-4 divide-y divide-slate-100 border border-slate-200">
    <% for (const row of past) { %>
    <li class="flex flex-wrap items-center gap-x-4 gap-y-1 px-4 py-2.5 text-sm">
      <span class="w-28 shrink-0 tabular-nums text-slate-500"><%= helpers.formatDate(row.life.shutdown) %></span>
      <a href="<%= helpers.modelPagePath(row.model) %>" class="font-medium text-slate-900 hover:text-accent"><%= row.model.name %></a>
      <span class="font-mono text-xs text-slate-500"><%= row.model.model %></span>
      <span class="ml-auto text-xs text-slate-400"><%= helpers.providerLabel(row.model.provider) %></span>
    </li>
    <% } %>
  </ul>
</section>
<% } %>
