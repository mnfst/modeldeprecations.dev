<dialog id="how-to-use" class="w-full max-w-3xl max-h-[85vh] overflow-y-auto bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-900/60 backdrop:backdrop-blur-sm">
  <div class="flex items-center justify-between border-b border-slate-200 px-6 py-4">
    <h2 class="text-lg font-semibold tracking-tight">How to use this site</h2>
    <button type="button" data-close-how-to-use aria-label="Close" class="inline-flex h-9 w-9 items-center justify-center text-slate-500 hover:bg-warm-hover hover:text-slate-900">
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" d="M18 6 6 18M6 6l12 12" /></svg>
    </button>
  </div>
  <div class="px-6 py-4">
    <p class="text-sm text-slate-600">The full guide, in Markdown. Copy it and hand it to a coding agent verbatim.</p>
    <div class="relative mt-4">
      <button type="button" data-copy-how-to-use class="absolute right-2 top-2 inline-flex items-center gap-1.5 border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium text-slate-600 hover:bg-warm-hover hover:text-slate-900">
        <span data-copy-label>Copy</span>
      </button>
      <pre id="how-to-use-md" class="max-h-[55vh] overflow-auto border border-slate-100 bg-slate-50 p-4 pr-20 font-mono text-xs leading-relaxed text-slate-800 whitespace-pre-wrap"><%= usageGuide %></pre>
    </div>
  </div>
</dialog>
