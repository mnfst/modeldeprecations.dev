{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/amazon/:path*",
      "destination": "/bedrock/:path*",
      "permanent": true
    },
    {
      "source": "/qwen/:path*",
      "destination": "/alibaba/:path*",
      "permanent": true
    },
    {
      "source": "/zai/:path*",
      "destination": "/z-ai/:path*",
      "permanent": true
    },
    {
      "source": "/api/v1/models/amazon/:path*",
      "destination": "/api/v1/models/bedrock/:path*",
      "permanent": true
    },
    {
      "source": "/api/v1/models/qwen/:path*",
      "destination": "/api/v1/models/alibaba/:path*",
      "permanent": true
    },
    {
      "source": "/api/v1/models/zai/:path*",
      "destination": "/api/v1/models/z-ai/:path*",
      "permanent": true
    },
    {
      "source": "/badge/amazon/:path*",
      "destination": "/badge/bedrock/:path*",
      "permanent": true
    },
    {
      "source": "/badge/qwen/:path*",
      "destination": "/badge/alibaba/:path*",
      "permanent": true
    },
    {
      "source": "/badge/zai/:path*",
      "destination": "/badge/z-ai/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(api|badge)/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=3600" }
      ]
    },
    {
      "source": "/api",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/badge/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/(llms.txt|llms-full.txt)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=3600" }
      ]
    },
    {
      "source": "/(.*).md",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/calendar.ics",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Content-Type", "value": "text/calendar; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" }
      ]
    },
    {
      "source": "/changelog.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/rss+xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=3600" }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/(styles.css|main.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
